#!/usr/bin/env ruby
# frozen_string_literal: true

# Usage: tools/boot_smoke out/<platform>
#
# Boot-smoke (conventions.md): run the packaged tool's --version FROM THE
# IMAGE (extracted with the pinned tfs CLI — extraction is THE smoke path
# on every platform: no FUSE semantics are needed to prove the bytes, and
# the static tier's run-time form is also extraction — the zero-runtime
# store tree), with an EMPTY environment — PATH/LD_LIBRARY_PATH unset —
# so success proves the $ORIGIN-relative closure is self-sufficient.
# Then: SVG -> PNG and SVG -> PDF export of fixtures/smoke.svg, and an
# ldd "not found" sweep over every ELF in the payload.

autoload :Tpkg, File.expand_path("lib/tpkg", __dir__)
require "tmpdir"

out_dir = ARGV[0] or Tpkg.die("usage: tools/boot_smoke out/<platform>")
img = Dir[File.join(out_dir, "*.tfs")].first or Tpkg.die("no .tfs image in #{out_dir}")
platform = File.basename(img).sub(/\Ainkscape-[\d.]+-/, "").sub(/\.tfs\z/, "")
macos = platform.end_with?("-macos")
windows = platform.end_with?("-windows-ucrt")
recipe = Tpkg.recipe(File.join(Tpkg::ROOT, "Tebakofile"))
tools = Tpkg.ensure_tfs_cli(recipe, platform: platform)
# prefer the image tool staged next to the image (same run's build/download)
staged = File.join(out_dir, "image-tools", windows ? "tfs.exe" : "tfs")
tools["tfs"] = staged if File.executable?(staged)

extracted = Dir.mktmpdir("tpkg-extract")
Tpkg.log("extract-mode smoke (tfs extract)")
Tpkg.sh(tools["tfs"], "extract", "-d", extracted, img)
point = extracted

begin
  bin = File.join(point, "bin", windows ? "inkscape.exe" : "inkscape")
  Tpkg.die("#{bin} missing in image") unless File.exist?(bin)

  home = Dir.mktmpdir("tpkg-home")
  # env -i: empty environment (+ HOME, + APPDATA as the win32 profile root)
  # — proves the closure is self-sufficient ($ORIGIN / @loader_path / the
  # exe-directory rule).
  env_prefix = ["env", "-i", "HOME=#{home}"]
  env_prefix << "APPDATA=#{home}" if windows
  ver, ok = Tpkg.capture(*env_prefix, bin, "--version")
  Tpkg.die("inkscape --version failed:\n#{ver}") unless ok && ver =~ /Inkscape 1\./
  Tpkg.log("boot: #{ver.lines.first.strip}")

  # dependency sweep: nothing unresolved, and nothing outside the closure
  bad = []
  if macos
    # otool sweep: refs must be system (/usr/lib, /System) or @rpath leaves
    # present inside the payload — any residual brew-tree path is a leak.
    sweep = Dir[File.join(point, "bin", "*"), File.join(point, "lib", "**", "*.{dylib,so}")].select { |f| Tpkg.macho?(f) }
    sweep.each do |f|
      Tpkg.otool_refs(f).each_with_index do |ref, i|
        next if i.zero? && f.end_with?(".dylib", ".so") # install name
        next if ref.match?(Tpkg::MACOS_SYSTEM_REF) || ref.start_with?("@loader_path/", "@executable_path/")
        if (m = ref.match(/\A@rpath\/(.+)/))
          leaf = m[1]
          bad << "#{f}: unresolved @rpath/#{leaf}" unless File.exist?(File.join(point, "lib", leaf)) ||
                                                         File.exist?(File.join(point, "lib", "inkscape", leaf))
        else
          bad << "#{f}: #{ref}"
        end
      end
    end
    Tpkg.die("otool sweep failed (leak/unresolved):\n  #{bad.join("\n  ")}") unless bad.empty?
    Tpkg.log("otool sweep: #{sweep.size} Mach-O files clean (no brew leaks beyond the closure)")
  elsif windows
    # objdump sweep: imports must be the Win32/NT system set or a DLL present
    # in bin/ next to the exe — anything else can never resolve at run time.
    sweep = Dir[File.join(point, "bin", "*.{exe,dll}"), File.join(point, "lib", "**", "*.dll")].select { |f| Tpkg.pe?(f) }
    sweep.each do |f|
      Tpkg.objdump_imports(f).each do |imp|
        next if Tpkg.windows_system_dll?(imp)
        bad << "#{f}: #{imp}" unless File.exist?(File.join(point, "bin", File.basename(imp)))
      end
    end
    Tpkg.die("objdump sweep failed (import outside the system set + bin/):\n  #{bad.join("\n  ")}") unless bad.empty?
    Tpkg.log("objdump sweep: #{sweep.size} PE files clean (system set + bin/ closure only)")
  else
    # ldd sweep: nothing may resolve to "not found"
    sweep = Dir[File.join(point, "bin", "*"), File.join(point, "lib", "**", "*.so*")].select { |f| Tpkg.elf?(f) }
    sweep.each do |elf|
      Tpkg.ldd_resolve(elf, []).each { |name, path| bad << "#{elf}: #{name}" if path.nil? && !Tpkg.excluded_lib?(name) }
    end
    Tpkg.die("ldd sweep unresolved:\n  #{bad.join("\n  ")}") unless bad.empty?
    Tpkg.log("ldd sweep: #{sweep.size} ELFs clean")
  end

  fixture = File.join(Tpkg::ROOT, "fixtures", "smoke.svg")
  Dir.mktmpdir("tpkg-export") do |tmp|
    png = File.join(tmp, "smoke.png")
    pdf = File.join(tmp, "smoke.pdf")
    out1, ok1 = Tpkg.capture(*env_prefix, bin, fixture, "--export-type=png", "--export-filename=#{png}")
    Tpkg.die("SVG->PNG export failed:\n#{out1}") unless ok1 && File.exist?(png)
    # .b: the file read is ASCII-8BIT; a bare "\x89" literal is UTF-8, and
    # == across incompatible encodings is false even with identical bytes.
    Tpkg.die("PNG magic mismatch") unless File.open(png, "rb") { |f| f.read(8) } == "\x89PNG\r\n\x1a\n".b
    Tpkg.die("PNG too small (#{File.size(png)} B)") if File.size(png) < 1000
    Tpkg.log("export: smoke.svg -> PNG (#{File.size(png)} B)")

    out2, ok2 = Tpkg.capture(*env_prefix, bin, fixture, "--export-type=pdf", "--export-filename=#{pdf}")
    Tpkg.die("SVG->PDF export failed:\n#{out2}") unless ok2 && File.exist?(pdf)
    Tpkg.die("PDF magic mismatch") unless File.open(pdf, "rb") { |f| f.read(5) } == "%PDF-"
    Tpkg.log("export: smoke.svg -> PDF (#{File.size(pdf)} B)")
  end
ensure
  FileUtils.rm_rf(extracted) if extracted
end
Tpkg.log("BOOT_SMOKE_OK #{File.basename(img)}")
