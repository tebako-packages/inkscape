#!/usr/bin/env ruby
# frozen_string_literal: true

# Usage: tools/build recipe.yml <version> <platform>
#
# fetch (sha256-verified) + vcpkg deps + cmake + install + closure pass.
# Produces out/<platform>/root — the relocatable payload tree:
#   root/bin/inkscape          RPATH $ORIGIN/../lib/inkscape (upstream default)
#   root/lib/inkscape/*.so     inkscape's own libs, RPATH $ORIGIN/..
#   root/lib/*.so              dependency closure (vcpkg + system), no rpath
#                              needed: DT_RPATH chain resolves transitively
#   root/share/inkscape/**     data (auto-found: exe-dir/../share/inkscape)
#
# No patchelf/chrpath anywhere: RPATH is wired at BUILD time
# (-Wl,--disable-new-dtags + upstream's own CMAKE_INSTALL_RPATH).

autoload :Tpkg, File.expand_path("lib/tpkg", __dir__)

recipe_path, version, platform = ARGV
Tpkg.die("usage: tools/build recipe.yml <version> <platform>") unless recipe_path && version && platform

recipe = Tpkg.recipe(recipe_path)
# vcpkg's compiler-hash tracking spawns a detect_compiler try_compile that
# can wedge under x86_64-on-arm64 emulation; disabling it is harmless on
# native runners (ABI tags just lose the compiler hash).
ENV["VCPKG_DISABLE_COMPILER_TRACKING"] ||= "1"
Tpkg.die("platform #{platform} not in recipe platforms") unless recipe["platforms"].include?(platform)
Tpkg.die("version #{version} != recipe upstream.version #{recipe.dig('upstream', 'version')}") unless version == recipe.dig("upstream", "version")
map = Tpkg::PLATFORM_MAP[platform] or Tpkg.die("unknown platform #{platform}")
triplet = map["vcpkg_triplet"]

out = File.join(Tpkg::ROOT, "out", platform)
root = File.join(out, "root")
work = File.join(out, "work")
FileUtils.mkdir_p([root, work])

# --- 1. system packages -----------------------------------------------------
pkgs = recipe.dig("build", "system_packages") || []
if ENV["TPKG_SKIP_APT"] != "1" && system("command -v apt-get >/dev/null 2>&1") && !pkgs.empty?
  sudo = Process.uid.zero? ? [] : ["sudo"]
  # retry: concurrent builders can hold the apt/dpkg locks
  3.times do |attempt|
    begin
      Tpkg.sh(*sudo, "apt-get", "update", "-qq")
      Tpkg.sh(*sudo, "apt-get", "install", "-y", "-qq", *pkgs)
      break
    rescue SystemExit
      raise if attempt == 2
      Tpkg.warn("apt attempt #{attempt + 1} failed (lock?); retrying in 20s")
      sleep 20
    end
  end
end
macos = platform.end_with?("-macos")
windows = platform.end_with?("-windows-ucrt")
# the ucrt64 root is the windows leg's ONE supplier root (toolchain + GNOME
# platform stack); tools/ci_run exports it. Named error, never a guess.
ucrt64 = ENV["UCRT64"]
if windows && (ucrt64.nil? || !File.directory?(File.join(ucrt64, "bin")))
  Tpkg.die("windows leg needs $UCRT64 pointing at the ucrt64 root (e.g. /d/a/_temp/msys64/ucrt64) — run under tools/ci_run")
end
brew_pkgs = recipe.dig("build", "brew_packages") || []
if macos && ENV["TPKG_SKIP_BREW"] != "1" && !brew_pkgs.empty?
  # Homebrew is the macOS platform-stack supplier (the apt counterpart): one
  # self-consistent source for the GNOME stack. Bottles are sha-verified by
  # brew itself against the formula pins.
  Tpkg.sh("brew", "install", *brew_pkgs)
end

# --- 2. upstream source (sha256-verified) -----------------------------------
up = recipe["upstream"]
tarball = Tpkg.fetch(up["url"], File.join(Tpkg.cache_dir, "src", File.basename(up["url"])), up["sha256"])
src = File.join(work, "src")
unless File.directory?(src)
  FileUtils.mkdir_p(src)
  # the archive operand is a bare name on purpose: a drive-letter-leading
  # path (D:\…) is GNU tar's rmt syntax (host:path — it tries to rsh to
  # host "D", exit 128). chdir + basename is portable across every tar.
  # MSYS=winsymlinks:nativestrict (windows only): the tarball ships a
  # dangling symlink (compile_commands.json -> a path on the upstream
  # maintainer's machine); POSIX tar creates it happily, msys tar's
  # default copy-the-target mode fails on the missing target. Native
  # symlinks mirror the POSIX legs exactly (the link stays dangling,
  # the build never reads it).
  tar_env = windows ? { "MSYS" => "winsymlinks:nativestrict" } : {}
  Tpkg.sh("tar", "-xf", File.basename(tarball), "-C", src, "--strip-components=1",
          chdir: File.dirname(tarball), env: tar_env)
  # feedstock patches (conventions.md), in name order; a patch that fails
  # `git apply --check` aborts the build, never applies partially on faith.
  Dir[File.join(Tpkg::ROOT, "patches", "*.patch")].sort.each do |p|
    Tpkg.sh("git", "apply", "--check", p, chdir: src, quiet: true)
    Tpkg.sh("git", "apply", p, chdir: src)
    Tpkg.log("applied #{File.basename(p)}")
  end
end

# --- 3. vcpkg deps (commit-pinned) -------------------------------------------
vcpkg = Tpkg.vcpkg_root_for(recipe)
vcpkg_exe = File.join(vcpkg, windows ? "vcpkg.exe" : "vcpkg")
unless File.executable?(vcpkg_exe)
  if windows
    # bootstrap-vcpkg.bat downloads the prebuilt vcpkg.exe (no compiler
    # needed) but drives powershell, which lives outside the closed PATH —
    # prepend it for this one child. cmd needs native path separators.
    boot = File.join(vcpkg, "bootstrap-vcpkg.bat").tr("/", "\\")
    Tpkg.sh("cmd", "/c", boot, "-disableMetrics", chdir: vcpkg,
            env: { "PATH" => "C:\\Windows\\System32\\WindowsPowerShell\\v1.0;#{ENV['PATH']}" })
  else
    Tpkg.sh(File.join(vcpkg, "bootstrap-vcpkg.sh"), "-disableMetrics", chdir: vcpkg)
  end
end
vlib = File.join(vcpkg, "installed", triplet, "lib")
# vcpkg install is incremental; run it every time so recipe port-list
# changes take effect (already-installed ports no-op quickly).
Tpkg.sh(vcpkg_exe, "install", *recipe.dig("build", "vcpkg", "ports"),
        "--triplet", triplet,
        "--overlay-triplets=#{File.join(Tpkg::ROOT, 'tools', 'triplets')}",
        "--clean-buildtrees-after-build",
        chdir: Tpkg::ROOT)

# --- 4. cmake configure + build + install ------------------------------------
build_dir = File.join(work, "build")
cmake = recipe.dig("build", "cmake")
# per-platform option overrides (e.g. macOS: no --disable-new-dtags on ld64,
# @loader_path rpath flags instead of DT_RPATH)
options = cmake["options"].merge(recipe.dig("build", "platform_cmake_options", platform) || {})
opts = options.map { |k, v| "-D#{k}=#{v}" }
# vcpkg's toolchain covers find_package, but pkg_check_modules (gsl, bdw-gc,
# lcms2, …) needs PKG_CONFIG_PATH pointed at the vcpkg installed tree;
# PKG_CONFIG_PATH prepends to the system defaults, so the platform-stack .pc
# files (apt's gtkmm-3.0 & co. on linux, brew's on macOS, ucrt64's native
# path on windows) still resolve. Separator is ";" on windows (native
# pkgconf), ":" elsewhere.
pkg_env = { "PKG_CONFIG_PATH" => [
  File.join(vcpkg, "installed", triplet, "lib", "pkgconfig"),
  File.join(vcpkg, "installed", triplet, "share", "pkgconfig")
].join(windows ? ";" : ":") }
# 2geom links bare `-lgsl`/`-lgslcblas` (no -L): give the linker the vcpkg
# lib dir. Appended -D flags override the recipe's same-named ones.
ld_extra = "-L#{vlib}"
if macos
  # keg-only brew formulae inkscape hard-requires: libintl (FindIntl is
  # unconditional, even with WITH_NLS=OFF) and libomp (WITH_OPENMP).
  kegs = %w[gettext libomp].filter_map { |f| Tpkg.brew_prefix(f) }
  opts << "-DCMAKE_PREFIX_PATH=#{kegs.join(';')}" unless kegs.empty?
  if (omp = Tpkg.brew_prefix("libomp"))
    # upstream folds OpenMP_{C,CXX}_FLAGS into the compile lines but never
    # adds OpenMP_{C,CXX}_INCLUDE_DIR (invisible on linux: gcc ships omp.h
    # on the default include path) — inject libomp's include + lib dirs.
    opts << "-DCMAKE_C_FLAGS=-I#{omp}/include"
    opts << "-DCMAKE_CXX_FLAGS=-I#{omp}/include"
    ld_extra += " -L#{omp}/lib"
  end
end
%w[CMAKE_EXE_LINKER_FLAGS CMAKE_SHARED_LINKER_FLAGS CMAKE_MODULE_LINKER_FLAGS].each do |k|
  opts << "-D#{k}=#{options[k]} #{ld_extra}"
end
# always re-run configure: it is incremental and picks up flag/port changes
Tpkg.sh("cmake", "-S", src, "-B", build_dir,
        "-G", cmake["generator"],
        "-DCMAKE_BUILD_TYPE=#{cmake['build_type']}",
        "-DCMAKE_INSTALL_PREFIX=#{root}",
        "-DCMAKE_TOOLCHAIN_FILE=#{File.join(vcpkg, 'scripts/buildsystems/vcpkg.cmake')}",
        "-DVCPKG_TARGET_TRIPLET=#{triplet}",
        "-DVCPKG_OVERLAY_TRIPLETS=#{File.join(Tpkg::ROOT, 'tools', 'triplets')}",
        *opts, env: pkg_env)
Tpkg.sh("cmake", "--build", build_dir, "--parallel", ENV.fetch("TPKG_JOBS", "4"))
Tpkg.sh("cmake", "--install", build_dir)

# --- 5. closure pass: every resolved dep lib (minus the OS family) into lib/ --
Tpkg.log("closure pass")
libd = File.join(root, "lib")
if macos
  # gdk-pixbuf loaders (dlopen'd — otool of the binaries never sees them):
  # copy brew's module tree first so the closure walk closes over them too.
  gdk_prefix = Tpkg.brew_prefix("gdk-pixbuf")
  gdk = gdk_prefix && Dir[File.join(gdk_prefix, "lib", "gdk-pixbuf-2.0")].first
  if gdk
    # remove_destination: re-runnable. Brew bottles are read-only (0444);
    # strip/install_name_tool/codesign need write access on the copies.
    FileUtils.cp_r(gdk, libd, remove_destination: true)
    FileUtils.chmod_R("u+w", File.join(libd, "gdk-pixbuf-2.0"))
  end

  # fontconfig stock config: lets the shim point FONTCONFIG_FILE into the
  # image. Brew keeps it at the HOMEBREW_PREFIX level (not in the keg).
  homebrew = Tpkg.brew_prefix(nil)
  fonts_etc = homebrew ? File.join(homebrew, "etc", "fonts") : "/nonexistent"
  if File.directory?(fonts_etc)
    FileUtils.mkdir_p(File.join(root, "etc"))
    FileUtils.cp_r(fonts_etc, File.join(root, "etc"), remove_destination: true)
    FileUtils.chmod_R("u+w", File.join(root, "etc", "fonts"))
  end

  # vcpkg deps are static on macOS (arm64-osx-static): linked INTO the
  # inkscape binaries, so the dylib closure is 100% brew-supplied.
  copied = Tpkg.macos_closure(root, stamp: File.join(work, "closure-leaves.txt"))
  closure_count = copied.size
elsif windows
  # gdk-pixbuf loaders (dlopen'd — objdump of the binaries never sees them):
  # copy the module tree first so the closure walk closes over them too.
  # (loaders.cache holds absolute build-machine paths; same known limitation
  # as the other legs — the run-time shim sets GDK_PIXBUF_MODULE_FILE, and
  # plain SVG->PNG/PDF export never touches the loaders.)
  gdk = File.join(ucrt64, "lib", "gdk-pixbuf-2.0")
  FileUtils.cp_r(gdk, libd) if File.directory?(gdk)

  # fontconfig stock config: lets the shim point FONTCONFIG_FILE into the image.
  fonts_etc = File.join(ucrt64, "etc", "fonts")
  if File.directory?(fonts_etc)
    FileUtils.mkdir_p(File.join(root, "etc"))
    FileUtils.cp_r(fonts_etc, File.join(root, "etc"))
  end

  # GLib's win32 spawn-time helpers (they are not import-table material —
  # glib resolves them next to its DLL at g_spawn/gdbus time): the pieces
  # of upstream's neutralized InstallMSYS2 bundling the CLI payload keeps.
  %w[gspawn-win64-helper.exe gspawn-win64-helper-console.exe gdbus.exe].each do |h|
    src_h = File.join(ucrt64, "bin", h)
    FileUtils.cp(src_h, File.join(root, "bin", h)) if File.exist?(src_h)
  end

  # PE/DLL closure: objdump import walk, the Win32/NT API surface excluded,
  # supplier DLLs flat into bin/ next to the exe (PE has no RPATH — the
  # loader searches the exe's directory first). Suppliers are vcpkg-first:
  # on name collisions (zlib1.dll, libpng16-16.dll) the vcpkg build wins —
  # it is the symbol superset we linked (the linux leg's SONAME rule).
  copied = Tpkg.windows_closure(root, suppliers: [
    File.join(vcpkg, "installed", triplet, "bin"),
    File.join(ucrt64, "bin")
  ])
  closure_count = copied.size
else
  search = [vlib, libd] # vcpkg first: on SONAME collisions (libpng/zlib) the
                        # vcpkg build wins — it is the symbol superset we linked
  copied = {}
  seen = {}
  close_lib = lambda do |name, path, queue|
    next if path.nil? || Tpkg.excluded_lib?(name)
    real = File.realpath(path)
    dest = File.join(libd, name)
    if copied.key?(name)
      Tpkg.warn("SONAME #{name} already closed from #{copied[name]}, skipping #{real}") if copied[name] != real
      next
    end
    if File.exist?(dest) && File.realpath(dest) == real
      copied[name] = real # payload's own lib (e.g. lib2geom) — already in place
      next
    end
    FileUtils.cp(real, dest)
    copied[name] = real
    queue << dest unless seen[dest]
  end
  queue = Dir[File.join(root, "bin", "*"), File.join(libd, "**", "*.so*")].select { |f| Tpkg.elf?(f) }
  until queue.empty?
    elf = queue.shift
    next if seen[elf]
    seen[elf] = true

    Tpkg.ldd_resolve(elf, search).each { |name, path| close_lib.call(name, path, queue) }
  end
  Tpkg.log("closure: #{copied.size} libs")

  # gdk-pixbuf loaders (dlopen'd — ldd of the binaries never sees them):
  # copy the module tree; each loader then joins the closure itself.
  gdk = Dir["/usr/lib/*/gdk-pixbuf-2.0"].first
  if gdk
    FileUtils.cp_r(gdk, libd)
    Dir[File.join(libd, "gdk-pixbuf-2.0", "**", "*.so")].select { |f| Tpkg.elf?(f) }.each do |loader|
      Tpkg.ldd_resolve(loader, search).each { |name, path| close_lib.call(name, path, []) }
    end
    Tpkg.log("closure incl. gdk-pixbuf loaders: #{copied.size} libs")
  end

  # fontconfig stock config: lets the shim point FONTCONFIG_FILE into the image.
  if File.directory?("/etc/fonts")
    FileUtils.mkdir_p(File.join(root, "etc"))
    FileUtils.cp_r("/etc/fonts", File.join(root, "etc"))
  end
  closure_count = copied.size
end

if macos || windows
  # Resolve every payload symlink to a plain file copy. macOS: libtfs
  # v0.13.0's dwarfs backend (filesystem_v2_lite) cannot READ symlink inodes
  # (fontconfig's etc/fonts/conf.d/*.conf are symlinks too; upstream
  # follow-up: symlink support there). windows: pacman trees can carry msys
  # symlinks, and extraction on a windows host cannot count on symlink
  # creation privileges. mkdwarfs dedups identical content either way, so
  # the image size is unaffected.
  Dir[File.join(root, "**", "*")].select { |f| File.symlink?(f) }.each do |l|
    target = File.realpath(l)
    FileUtils.rm(l)
    FileUtils.cp(target, l)
    Tpkg.log("resolved symlink #{l.sub("#{root}/", '')} -> #{File.basename(target)}")
  end
end

# prune payload dead weight the CLI never reads (87 MB of tutorial SVGs)
FileUtils.rm_rf(File.join(root, "share", "inkscape", "tutorials"))

# --- 6. strip (+codesign) + pre-image smoke (empty env: @loader_path/$ORIGIN
#         / the exe-directory rule must suffice) --------------------------------
if macos
  # GNU strip flags don't exist on macOS; -x removes local symbols only —
  # the safe form for dylibs. codesign AFTER strip: both strip and
  # install_name_tool invalidate the link-time ad-hoc signature, and an
  # arm64 binary with a broken signature is killed at exec.
  machos = Dir[File.join(root, "**", "*")].select { |f| Tpkg.macho?(f) }
  Tpkg.sh("strip", "-x", *machos) unless machos.empty?
  Tpkg.codesign_tree(root)
elsif windows
  # ucrt64 binutils strip.exe (unprefixed — same toolchain rule as objdump);
  # PE exports live in .edata, --strip-unneeded is the msys2-standard form.
  pes = Dir[File.join(root, "bin", "*.{exe,dll}"), File.join(root, "lib", "**", "*.dll")].select { |f| Tpkg.pe?(f) }
  Tpkg.sh("strip", "--strip-unneeded", *pes) unless pes.empty?
else
  Tpkg.sh("sh", "-c", "find #{Shellwords.escape(root)} -name '*.so*' -type f -exec strip --strip-unneeded {} +")
  Tpkg.sh("strip", File.join(root, "bin", "inkscape"))
end
require "tmpdir"
home = Dir.mktmpdir
exe = File.join(root, "bin", windows ? "inkscape.exe" : "inkscape")
# APPDATA is the win32 profile root (the HOME analog): redirecting it keeps
# inkscape's first-run profile writes out of the payload tree.
smoke_env = { "HOME" => home }.merge(windows ? { "APPDATA" => home } : {})
out_txt, ok = Tpkg.capture(exe, "--version", env: smoke_env)
Tpkg.die("pre-image smoke failed:\n#{out_txt}") unless ok
Tpkg.log("pre-image smoke: #{out_txt.lines.first&.strip}")
if macos
  # the smoke run drops runtime profile dirs into the payload root
  # (.config/inkscape/preferences.xml, .cache) — they must not ship.
  FileUtils.rm_rf([File.join(root, ".config"), File.join(root, ".cache")])
end

File.write(File.join(out, "build-meta.json"), JSON.pretty_generate({
  "name" => recipe["name"], "version" => version, "platform" => platform,
  "vcpkg_triplet" => triplet, "closure_libs" => closure_count,
  "built_at" => Time.now.utc.strftime("%Y-%m-%dT%H:%M:%SZ")
}))
Tpkg.log("payload tree ready: #{root}")
