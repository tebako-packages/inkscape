# Feedstock recipe for inkscape
# spec 13 §9 + docs/conventions.md in tebako-packages/index
name: "inkscape"
kind: toolkit
summary: "Vector graphics editor (CLI tools) — metanorma's graphics chain"

upstream:
  url: "https://media.inkscape.org/dl/resources/file/inkscape-1.4.3.tar.xz"
  sha256: "e83a2c3db570b6c5a1ff0fccfe7098837b3f6bd74b133567937c8a91710ed1d1"
  version: "1.4.3"

build:
  system: cmake
  link_mode: dynamic       # preload-shim exec tier (docs/conventions.md) —
                           # POSIX legs. The WINDOWS leg runs the static tier
                           # instead (see the exec_tier note at the bottom):
                           # no LD_PRELOAD exists on windows and libtfs-preload
                           # is POSIX-only, so the payload extracts and runs
                           # from the store tree (DLLs next to the exe — PE
                           # has no RPATH; the loader searches the exe's
                           # directory first).
  rpath_origin: true       # $ORIGIN-relative RPATH wired at BUILD time via
                           # --disable-new-dtags; no patchelf/chrpath anywhere
                           # (ELF legs; PE has no RPATH — the windows closure
                           # lands flat in bin/ next to the exe)
  deps: []                 # no feedstock deps

  # Dependency provenance (full rationale in docs/build-notes.md):
  #  * vcpkg (pinned commit) builds inkscape's non-GNOME deps — shared libs on
  #    linux, static on macOS (arm64-osx-static: they link into the binaries
  #    and drop out of the dylib closure entirely), DLLs on windows
  #    (x64-mingw-dynamic, a community triplet — they join the PE/DLL closure).
  #  * The GNOME platform stack (gtkmm-3.0 ABI family) comes from the OS
  #    package manager — ubuntu-24.04 apt on linux, Homebrew bottles on macOS,
  #    msys2 pacman (ucrt64) on windows: modern vcpkg ships only
  #    gtkmm4/glibmm-2.68 and no libsigc++-2.0 or potrace, while inkscape
  #    1.4.x hard-requires gtkmm-3.0 >= 3.24. One self-consistent supplier
  #    per platform, same rule on every leg. (ucrt64 is also THE windows
  #    toolchain — the same gcc family the ruby runtime factory and the
  #    vcpkg baseline use; inkscape's official windows packages are built
  #    with exactly this stack, which pins the porting risk to the closure.)
  vcpkg:
    git: "https://github.com/microsoft/vcpkg.git"
    commit: "cd61e1e26a038e82d6550a3ebbe0fbbfe7da78e3"   # tag 2026.06.24 (annotated tag object 52c9e08c)
    ports:
      - gsl
      - bdwgc
      - lcms
      - double-conversion
      - libpng
      - zlib
      - libxml2
      - libxslt
      # modular boost: compiled libs we link + header-only modules the
      # sources include (enumerated from `#include <boost/...>` across the
      # tree; boost/python is 2geom's off-by-default py2geom, boost/regex
      # an adaptagrams test — both excluded)
      - boost-filesystem
      - boost-stacktrace
      - boost-algorithm
      - boost-array
      - boost-asio
      - boost-assign
      - boost-bimap
      - boost-compute
      - boost-concept-check
      - boost-graph
      - boost-intrusive
      - boost-iterator
      - boost-lexical-cast
      - boost-math
      - boost-multi-index
      - boost-numeric-conversion
      - boost-optional
      - boost-property-map
      - boost-ptr-container
      - boost-range
      - boost-unordered

    # Per-platform port exclusions (subtracted from the list above; the
    # excluded dep's supplier for that leg is documented in the matching
    # system/brew/pacman section).
    exclude_ports_per_platform:
      x86_64-windows-ucrt:
        # vcpkg's gsl is a cmake-wrapper port: its gsl sources carry NO
        # __declspec markers, so the DLL's exports depend entirely on
        # WINDOWS_EXPORT_ALL_SYMBOLS — and the import library it produced
        # for x64-mingw-dynamic resolved for -lgsl but exported nothing
        # (41/41 gsl symbols undefined at the lib2geom link, run
        # 30726633253; the declspec-carrying ports — double-conversion
        # & co. — link fine). gsl moves to the pacman supplier
        # (mingw-w64-ucrt-x86_64-gsl, autotools-built — the same build
        # upstream's own msys2 inkscape package links).
        - gsl

  system_packages:          # ubuntu-24.04 (apt) names
    # toolchain
    - build-essential
    - cmake
    - ninja-build
    - pkg-config
    - git
    - curl
    - ca-certificates
    - xz-utils
    - zip
    - unzip
    - tar
    - autoconf
    - autoconf-archive
    - automake
    - libtool
    - bison
    - flex
    - gperf
    - nasm
    - python3
    - python3-jinja2
    - ruby                   # feedstock tools
    # GNOME platform stack + inkscape deps vcpkg cannot serve (see above)
    - libgtkmm-3.0-dev       # pulls gtk3, glibmm-2.4, pangomm, cairomm, atkmm,
                             # sigc++-2.0, pango/cairo/harfbuzz/fontconfig/
                             # freetype/gdk-pixbuf -dev, libX11-dev
    - libpotrace-dev         # 'potrace' port is absent from vcpkg
    - libepoxy-dev           # must match the gtk3 build

  brew_packages:            # macOS legs: Homebrew bottles are the macOS
                            # platform-stack supplier (apt counterpart) — ONE
                            # self-consistent source, same rule as linux
    # toolchain (preinstalled on macos-14 runners; idempotent).
    # The autotools set mirrors the linux system_packages toolchain:
    # vcpkg's make-based ports (gsl, libatomic_ops, libbacktrace, …) run
    # autoreconf and hard-require autoconf/automake/autoconf-archive/
    # libtoolize (brew's glibtoolize satisfies vcpkg's probe).
    - cmake
    - ninja
    - pkg-config
    - ruby                   # feedstock tools need >= 2.7; macOS system ruby is 2.6
    - autoconf
    - autoconf-archive
    - automake
    - libtool
    - bison
    - flex
    - gperf
    - nasm
    # GNOME platform stack — the gtkmm3 ABI family. gtkmm3 pulls the versioned
    # formulae glibmm@2.66 (glibmm-2.4 ABI), cairomm@1.14, pangomm@2.46,
    # atkmm@2.28, libsigc++@2 + gtk+3/pango/cairo/harfbuzz/fontconfig/
    # gdk-pixbuf — the same set apt's libgtkmm-3.0-dev serves on linux.
    - gtkmm3
    - libepoxy               # must match the gtk3 build (same supplier: brew)
    - potrace                # 'potrace' port is absent from vcpkg
    - gettext                # keg-only; upstream's FindIntl is unconditional
    - libomp                 # WITH_OPENMP parity with the linux leg (keg-only)

  pacman_packages:          # windows leg: msys2 ucrt64 is the platform-stack
                            # supplier (the apt/brew counterpart — ONE
                            # self-consistent source, same rule). Installed by
                            # tools/pacman_install under the msys2 shell;
                            # the toolchain itself comes from setup-msys2.
                            # mingw-w64-ucrt-x86_64-gtkmm3 pulls the whole
                            # gtkmm-3.0 ABI family (glibmm-2.4, cairomm-1.0,
                            # pangomm-1.4, atkmm-1.6, libsigc++-2.0 + gtk3/
                            # glib2/pango/cairo/harfbuzz/fontconfig/freetype/
                            # gdk-pixbuf2) — the set apt's libgtkmm-3.0-dev
                            # and brew's gtkmm3 serve on the other legs.
    - mingw-w64-ucrt-x86_64-gtkmm3
    - mingw-w64-ucrt-x86_64-libepoxy   # must match the gtk3 build (same supplier)
    - mingw-w64-ucrt-x86_64-potrace    # 'potrace' port is absent from vcpkg
    - mingw-w64-ucrt-x86_64-gettext-runtime  # libintl.h + libintl-8.dll:
                             # FindIntl is unconditional. (the old umbrella
                             # 'gettext' package is gone — msys2 split it
                             # into runtime/tools/libtextstyle)
    - mingw-w64-ucrt-x86_64-gsl        # replaces vcpkg's gsl on this leg —
                             # see build.vcpkg.exclude_ports_per_platform

  cmake:
    generator: "Ninja"
    build_type: "Release"
    options:
      # --- feature slimming: CLI export (SVG->PDF/PNG) only, no GUI extras ---
      WITH_NLS: "OFF"               # no translations (drops gettext)
      WITH_GNU_READLINE: "OFF"      # no interactive shell mode
      WITH_GSPELL: "OFF"            # GUI spell check
      WITH_GSOURCEVIEW: "OFF"       # GUI XML editor syntax coloring
      WITH_LIBCDR: "OFF"            # CorelDRAW import
      WITH_LIBVISIO: "OFF"          # Visio import
      WITH_LIBWPG: "OFF"            # WordPerfect import
      WITH_IMAGE_MAGICK: "OFF"      # raster extension helpers
      WITH_GRAPHICS_MAGICK: "OFF"   # ditto
      ENABLE_POPPLER: "OFF"         # PDF *import* only; PDF export is cairo-native
      ENABLE_POPPLER_CAIRO: "OFF"
      # --- payload wiring ---
      WITH_INTERNAL_2GEOM: "ON"     # 2geom is vendored in the release tarball
      BUILD_SHARED_LIBS: "ON"
      BUILD_TESTING: "OFF"
      CMAKE_INSTALL_LIBDIR: "lib"   # flat lib/, no multiarch subdir
      # old-dtags DT_RPATH so the $ORIGIN chain (exe -> libinkscape_base ->
      # closure libs) resolves transitively; see docs/build-notes.md §RPATH
      CMAKE_EXE_LINKER_FLAGS: "-Wl,--disable-new-dtags"
      CMAKE_SHARED_LINKER_FLAGS: "-Wl,--disable-new-dtags"
      CMAKE_MODULE_LINKER_FLAGS: "-Wl,--disable-new-dtags"

  # merged over build.cmake.options for the named platform
  platform_cmake_options:
    aarch64-macos:
      # ld64 has no --disable-new-dtags (GNU ld only). macOS @rpath resolution
      # is transitive down the load chain BY DESIGN, so upstream's build-time
      # rpaths (exe: @loader_path/../lib/inkscape, libinkscape_base:
      # @loader_path/..) plus this one cover the flat closure in lib/ — the
      # macOS form of the same wiring, still zero post-build RPATH edits.
      CMAKE_EXE_LINKER_FLAGS: "-Wl,-rpath,@loader_path/../lib"
      CMAKE_SHARED_LINKER_FLAGS: "-Wl,-rpath,@loader_path/../lib"
      CMAKE_MODULE_LINKER_FLAGS: "-Wl,-rpath,@loader_path/../lib"
    x86_64-windows-ucrt:
      # PE has no RPATH: --disable-new-dtags is ELF-only, so the global flags
      # are cleared here (tools/build re-appends the vcpkg -L path). DLL
      # resolution is the exe-directory rule instead: the closure lands flat
      # in bin/ next to inkscape.exe and needs no link-time wiring at all.
      CMAKE_EXE_LINKER_FLAGS: ""
      CMAKE_SHARED_LINKER_FLAGS: ""
      CMAKE_MODULE_LINKER_FLAGS: ""

image:
  format: limnifs
  # .tfs everywhere (the tebako fs image — LimniFS, the default format;
  # the store extension stays .tfs regardless of format).
  extension:
    default: tfs

# Factory tools used by the workflow (the imager: tfs mkimage/extract):
# the tebako/tfs CLIs from the tamatebako/tebako release. The asset digests
# are pinned HERE — tools.sha256 is the repo's toolchain pin SSOT (the
# workflow carries no version or digest literals; tools/pins.rb reads this
# block into $GITHUB_ENV) and cross-checked against the release's own
# SHA256SUMS at fetch time (the same trust-anchor role as upstream.sha256).
tools:
  repo: "tamatebako/tebako"
  release: "v2.8.21"         # v2.8.21's imager writes limnifs metadata
                             # inlined up to the 64 MiB product ceiling
                             # (this payload's blob is ≈1.5 MiB — older
                             # tools externalize past 1 MiB and the
                             # self-contained image cannot carry the
                             # sidecar). Also carries the spec 09 §9
                             # zero-interaction trust plane (tebako#564):
                             # the embedded root public key + primary-keyid
                             # registry signature pins — REQUIRED for the
                             # publish-signing leg (the signing: block
                             # below): the publish's own clean-cache verify
                             # resolves the registry's signature pins
                             # against the embedded root, and an older CLI
                             # would fail closed on its own signed publish.
  sha256:
    tebako:
      macos-arm64: "e6269526d268f5ef0b6718fbbde02efe7c957733adca9971c755ad544710f6a2"
      linux-gnu-x86_64: "9f4a610d73b90b77d6bff3ff0e55fb691f74a54d52bd342ada59917195521d9a"
      linux-gnu-arm64:  "d123fcd6735a0a1fc917125a420e29744a183cabbf4337e3ed49f3e38e20b0c1"
      windows-ucrt64: "b2b98454c626020c50288818568d0e743c0dc7a8d57cdf91d8a8d48489eafdad"
    tebako-shim:
      macos-arm64: "9390ac1fff96df43ac847e271a3ff854a53d5f02baad1f3674cc8596b36ff9e6"
      linux-gnu-x86_64: "f07b025832eaf9ba1c416e306d607791e2a90418a3174b62d4510a7eba9d1f91"
      linux-gnu-arm64:  "7c199d2571ef903b104303d1fe58d87a0122dab591c0093bac577050ccbb8dd6"
      windows-ucrt64: "fd3da369ddc795f9f2228ce5dbfe3c2ddc7fed2c4337974d44c461d88b4bdaf0"
    tfs:
      macos-arm64: "38f4493c1a65d37ace603db171c23d9a4580bd6053e3a3007800fbcf7a494d83"
      linux-gnu-x86_64: "8b752cb7bc8337960bf77f36cc375e6bc6f75b1d78e6d50c0000a33b26be51b9"
      linux-gnu-arm64:  "a8042810a1428dd4dbab8ff3473a0015160ed1b529c74007bbbb2bf075c1a03f"
      windows-ucrt64: "e5128ef8be90813bf9300dda39f204fff39f6d1e3eb4963128cbdfaeed88744a"

# Signing (spec 09 §9 — opt-in per feedstock): on tag pushes the publish
# step signs every payload image (plus SHA256SUMS and the registry itself)
# with the CI signing subkey of the tamatebako root, supplied as the org
# secret TEBAKO_CI_SIGNING_KEY, and the registry pins the PRIMARY keyid
# (the identity, not the rotating subkey instrument). A declared signing
# block with an absent secret FAILS the publish — a signing feedstock
# never ships an unsigned release silently. No signing.tool sub-block
# (hello needed a separate signer binary): the publisher IS the tools
# block's pinned tebako CLI — v2.6.0, the first release whose embedded
# root public key verifies the registry's signature pins at the publish's
# own clean-cache verify.
signing:
  keyid: "efc3c250f7862a48" # 2026-09-09 tamatebako root primary (low 64)

# phase A: x86_64-linux-gnu + aarch64-macos (macOS dogfood leg);
# aarch64-linux-gnu and x86_64-macos legs follow.
# x86_64-windows-ucrt: the mingw port of the dependency closure (ucrt64 gcc
# toolchain, pacman GNOME stack, PE/DLL closure into bin/ — the static exec
# tier, see below).
platforms:
  - x86_64-linux-gnu
  - aarch64-linux-gnu
  - aarch64-macos
  - x86_64-windows-ucrt

provides:
  executables:
    # the windows image carries /bin/inkscape.exe (stage fills the suffix)
    - {name: "inkscape", path: "/bin/inkscape", version: "1.4.3"}
  libraries: []

exec_tier: dynamic         # from build.link_mode — POSIX legs. The windows
                           # leg is the STATIC tier (spec 07 §8 tier 2b,
                           # extract-to-exec-cache): tier 1's preload shim
                           # does not exist on windows (libtfs-preload is
                           # POSIX-only, "windows later"), and no link-time
                           # interposition archive ships for payload exes
                           # (the tebako-rs link-unit is the RUNTIME driver
                           # unit, not a CRT interposition shim; a GLib app's
                           # windows IO surface is the Win32 API, which GNU
                           # ld --wrap cannot reach). The zero-runtime
                           # dispatcher execs the materialized exe; the PE
                           # closure in bin/ makes it self-sufficient.
exec_closure: []
